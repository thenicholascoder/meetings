# Shared secrets for Docker Compose. From the repo root:
#   copy .env.example .env
#
# Compose reads this file and does not read backend/.env. Keep it.
# Service addresses are defaults in docker-compose.yml
# (http://livekit:7880, http://minio:9000, http://converter:3000).
# Set one here only to override that default, for example on a LAN:
#   LIVEKIT_URL=ws://192.168.1.10:7880
#
# LIVEKIT_API_KEY and LIVEKIT_API_SECRET must match infra/livekit.yaml keys.
# Local Django loads this file for any name that backend/.env does not set.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=meetings

LIVEKIT_API_KEY=meetingskey
LIVEKIT_API_SECRET=dev_meetings_secret_change_me_32chars_min

S3_KEY_ID=minio
S3_KEY_SECRET=minio12345
S3_BUCKET=recordings
