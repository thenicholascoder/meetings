# Host addresses for `python manage.py runserver`. From backend/:
#   copy .env.example .env
#
# This file is not a second copy of the repo-root .env. Django reads this
# file first, then fills missing names from the root file. Put a name here
# only when the host must use a different address than the Compose default.
# The API key, API secret, S3 key, and bucket stay in the root file.
#
# DATABASE_URL's password must match POSTGRES_PASSWORD in the root .env.
# S3_ENDPOINT is sent to Egress, which runs in Docker and reaches MinIO
# through the host. S3_PUBLIC_ENDPOINT is the URL the browser opens.

DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgres://meetings:meetings@127.0.0.1:5432/meetings

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_URL=http://127.0.0.1:7880
PPTX_CONVERTER_URL=http://127.0.0.1:3100

S3_ENDPOINT=http://host.docker.internal:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# Set this to keep each MP4 on disk instead of uploading it. The path is the
# host folder Compose mounts at /out in the Egress container.
# RECORDING_LOCAL_DIR=C:\Users\Nico\meetings\backend\recordings
