# Local Next.js only (`npm run dev` from frontend/).
#   copy .env.example .env.local
#
# Next.js loads .env.local and does not commit it. The Docker frontend
# image ignores this file. Its public values are build args in
# docker-compose.yml.
#
# Anything named NEXT_PUBLIC_ is compiled into the browser bundle.
# Do not put LiveKit secrets, Django secrets, or S3 keys in this file.
# The browser asks Django for a token. It never signs one itself.
# https://docs.livekit.io/frontends/build/authentication/endpoint.md

NEXT_PUBLIC_LK_TOKEN_ENDPOINT=/api/getToken
NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record
NEXT_PUBLIC_SHOW_SETTINGS_MENU=true

# Server-side rewrite target for /api/*. Django on the host.
# Inside Compose, Caddy routes /api to the backend, so this is unused there.
API_INTERNAL_URL=http://127.0.0.1:8000
